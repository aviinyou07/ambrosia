# ─── Runtime ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────
# Preferred: a single connection URL.
# For a Coolify-managed Postgres use the INTERNAL hostname Coolify shows on
# the database page, e.g.
#   postgres://postgres:<password>@<coolify-db-service-name>:5432/ambrosia_db
DATABASE_URL=postgres://postgres:password@localhost:5432/ambrosia_db

# Fallback discrete keys (used only when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ambrosia_db
DB_USER=postgres
DB_PASSWORD=

# TLS to Postgres. Leave EMPTY for a Coolify-managed Postgres on the private
# Docker network (it serves no TLS). Set to `require` for a hosted provider
# such as Neon / Supabase / RDS, or `verify` to also validate the CA.
DB_SSL=

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_here

# ─── Object storage (S3-compatible: RustFS / R2 / MinIO / S3) ──────────────
# This deployment uses the self-hosted RustFS service in Coolify's
# "Shared services" project. Any S3-compatible endpoint works.
S3_ENDPOINT=https://s3.173.249.2.14.sslip.io
S3_BUCKET=ambrosia
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Browser-facing base URL for uploaded files. Leave empty to derive it as
# <S3_ENDPOINT>/<S3_BUCKET> (correct for path-style, which RustFS uses).
S3_PUBLIC_URL=

# RustFS and MinIO need path-style addressing; this is the default.
S3_FORCE_PATH_STYLE=true

# Apply an anonymous GetObject policy to the bucket on boot so the browser can
# load uploaded images. Set false if a CDN or signed URLs will serve them.
S3_PUBLIC_READ=true

# Used only by the local-disk fallback, when no S3 credentials are set.
PUBLIC_API_URL=https://api.ambrosiavastra.com

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. Added to the built-in allow-list in src/server.ts.
ALLOWED_ORIGINS=https://ambrosiavastra.com,https://www.ambrosiavastra.com,https://admin.ambrosiavastra.com
