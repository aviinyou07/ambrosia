# ─── Runtime ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────
# Preferred: a single connection URL.
# For a Coolify-managed Postgres use the INTERNAL hostname Coolify shows on
# the database page, e.g.
#   postgres://postgres:<password>@<coolify-db-service-name>:5432/ambrosia_db
DATABASE_URL=postgres://postgres:password@localhost:5432/ambrosia_db

# Fallback discrete keys (used only when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ambrosia_db
DB_USER=postgres
DB_PASSWORD=

# TLS to Postgres. Leave EMPTY for a Coolify-managed Postgres on the private
# Docker network (it serves no TLS). Set to `require` for a hosted provider
# such as Neon / Supabase / RDS, or `verify` to also validate the CA.
DB_SSL=

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_here

# ─── Cloudflare R2 ─────────────────────────────────────────────────────────
R2_ACCOUNT_ID=80cb977372f202bf141deb4906b650d6
R2_BUCKET_NAME=ambrosia
R2_PUBLIC_URL=https://pub-8204a887dc104db5bc9768e902671861.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. Added to the built-in allow-list in src/server.ts.
ALLOWED_ORIGINS=https://ambrosiavastra.com,https://www.ambrosiavastra.com,https://admin.ambrosiavastra.com
