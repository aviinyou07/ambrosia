# Base URL of the backend REST API.
# NOTE: this is a NEXT_PUBLIC_* value, so it is baked into the client bundle at
# BUILD time. In Coolify it must be set as a *Build Variable*, not only a
# runtime env var, or the browser bundle will point at the wrong host.
NEXT_PUBLIC_API_URL=https://api.ambrosiavastra.com/api/v1

# Cloudflare R2 Edge CDN URL (also build-time)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-8204a887dc104db5bc9768e902671861.r2.dev
