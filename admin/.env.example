# Base URL of the backend REST API.
# NOTE: NEXT_PUBLIC_* values are baked into the client bundle at BUILD time. In
# Coolify they must be set as Build Variables, not runtime-only env vars.
NEXT_PUBLIC_API_URL=https://api.ambrosiavastra.com/api/v1

# Public base URL of the object storage (RustFS), used for <Image> hosts.
NEXT_PUBLIC_R2_PUBLIC_URL=https://s3.173.249.2.14.sslip.io/ambrosia
